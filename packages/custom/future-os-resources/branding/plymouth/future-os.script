# Plymouth boot splash - Future OS

Window.SetBackgroundTopColor(0.04, 0.06, 0.10);
Window.SetBackgroundBottomColor(0.05, 0.08, 0.15);

logo_image = Image("future-os-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 60);

progress_bg = Image.CreateFilledRectangle(400, 4, 0.11, 0.16, 0.27, 1.0);
progress_bg_sprite = Sprite(progress_bg);
progress_bg_sprite.SetX(Window.GetWidth() / 2 - 200);
progress_bg_sprite.SetY(Window.GetHeight() / 2 + 60);

progress_sprite = Sprite();
progress_sprite.SetX(Window.GetWidth() / 2 - 200);
progress_sprite.SetY(Window.GetHeight() / 2 + 60);

fun boot_progress_cb(time, progress) {
    scaled = Image.CreateFilledRectangle(Math.Int(400 * progress), 4, 0.00, 0.83, 1.00, 1.0);
    progress_sprite.SetImage(scaled);
}

Bootup.ConnectToFunction("boot-progress", boot_progress_cb);
